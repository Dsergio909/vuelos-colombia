table Calendario
	lineageTag: 3a3d77cf-9b0a-533c-b708-c10c22e070b2

	column Fecha
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 48458d3d-aa36-5682-8fde-95d9d0725811
		summarizeBy: none
		sourceColumn: Fecha

		annotation SummarizationSetBy = User

	column 'Año'
		dataType: int64
		formatString: 0
		lineageTag: 05785dff-2f4f-553e-8657-adc6f3a6d131
		summarizeBy: none
		sourceColumn: Año

		annotation SummarizationSetBy = User

	column Mes
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: c07ad23f-30ee-56e5-90ad-0922764f2f21
		summarizeBy: none
		sourceColumn: Mes

		annotation SummarizationSetBy = User

	column 'Nombre mes'
		dataType: string
		lineageTag: dc169b37-b3da-5603-9534-411e86ecfda8
		summarizeBy: none
		sourceColumn: Nombre mes
		sortByColumn: Mes

		annotation SummarizationSetBy = User

	column 'Mes largo'
		dataType: string
		lineageTag: 64fb89a5-bf00-55f1-9410-876071500516
		summarizeBy: none
		sourceColumn: Mes largo
		sortByColumn: Mes

		annotation SummarizationSetBy = User

	partition Calendario = m
		mode: import
		source =
				// Calendario mensual: del primer al último mes que traen los datos.
				let
				    Fin = List.Max(Trafico[Fecha]),
				    Meses = List.Generate(() => #date(2020, 1, 1), each _ <= Fin, each Date.AddMonths(_, 1)),
				    Tabla = Table.FromList(Meses, Splitter.SplitByNothing(), type table [Fecha = date]),
				    Año = Table.AddColumn(Tabla, "Año", each Date.Year([Fecha]), Int64.Type),
				    Mes = Table.AddColumn(Año, "Mes", each Date.Month([Fecha]), Int64.Type),
				    NombreMes = Table.AddColumn(Mes, "Nombre mes",
				        each {"ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"}{[Mes] - 1}, type text),
				    NombreLargo = Table.AddColumn(NombreMes, "Mes largo",
				        each {"enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre",
				              "octubre", "noviembre", "diciembre"}{[Mes] - 1}, type text)
				in
				    NombreLargo

	annotation PBI_ResultType = Table
