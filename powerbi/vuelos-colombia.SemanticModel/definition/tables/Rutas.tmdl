table Rutas
	lineageTag: 94b8fefd-caa9-5e4d-9714-d0a5cdc16cb5

	column Ruta
		dataType: string
		lineageTag: 0b0c84f2-bbc4-582d-89ed-6be9e6630575
		summarizeBy: none
		sourceColumn: Ruta

		annotation SummarizationSetBy = User

	column 'Nombre ruta'
		dataType: string
		lineageTag: d2d28220-f354-5094-ae43-4aa4231c21f7
		summarizeBy: none
		sourceColumn: Nombre ruta

		annotation SummarizationSetBy = User

	column 'Ciudad A'
		dataType: string
		lineageTag: 617211f5-2e99-5b0e-a85b-df026604ce96
		summarizeBy: none
		sourceColumn: Ciudad A

		annotation SummarizationSetBy = User

	column 'Ciudad B'
		dataType: string
		lineageTag: 6a6f741c-ac5d-55e3-a14e-fab870d5d417
		summarizeBy: none
		sourceColumn: Ciudad B

